# ==============================
# HFC Restaurant OS - Environment Variables
# Copy this file to .env and .env in apps/api / apps/web as needed
# ==============================

# ---------- API ----------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# MongoDB
MONGO_URI=mongodb://mongo:27017/hfc_ros

# Redis (optional - unset disables caching entirely, app runs normally)
REDIS_URL=redis://redis:6379
MONGO_ROOT_USER=hfc_admin
MONGO_ROOT_PASSWORD=change_me_strong_password

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Payments: MOCK, RAZORPAY, or JUSPAY. Restart/recreate the API after changing this.
PAYMENT_PROVIDER=MOCK
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret

# Razorpay (required when PAYMENT_PROVIDER=RAZORPAY)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Juspay HDFC (required when PAYMENT_PROVIDER=JUSPAY)
JUSPAY_ENV=sandbox
JUSPAY_MERCHANT_ID=
JUSPAY_KEY_UUID=
JUSPAY_PAYMENT_PAGE_CLIENT_ID=
JUSPAY_PUBLIC_KEY_PATH=/run/secrets/juspay/public.key
JUSPAY_PRIVATE_KEY_PATH=/run/secrets/juspay/private.key
PUBLIC_API_URL=http://localhost:4000

# ---------- WEB ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
