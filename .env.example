# ==============================
# HCF Restaurant OS - Environment Variables
# Copy this file to .env and .env in apps/api / apps/web as needed
# ==============================

# ---------- API ----------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# MongoDB
MONGO_URI=mongodb://mongo:27017/hcf_ros

# Redis (optional - unset disables caching entirely, app runs normally)
REDIS_URL=redis://redis:6379
MONGO_ROOT_USER=hcf_admin
MONGO_ROOT_PASSWORD=change_me_strong_password

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Payments (mock provider for Part 1)
PAYMENT_PROVIDER=MOCK
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret

# ---------- BROWSER THERMAL PRINTING ----------
# Order tokens and bills open browser print preview, sized for 58 mm paper.
# Direct ESC/POS printer output is currently paused; see docs/PRINTING.md.
PRINTER_DRIVER=DISABLED
PRINTER_COPIES=1
PRINTER_FOOTER=Thank you! Visit again

# ---------- WEB ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
